import { ExternalLink } from "lucide-react";
import type { ArticleSource } from "../data/articles";

export default function ArticleSources({
  sources,
}: {
  sources?: ArticleSource[];
}) {
  if (!sources || sources.length === 0) return null;

  return (
    <section className="mt-10 border-t border-white/10 pt-6">
      <h2 className="text-lg font-black">Sources</h2>

      <ul className="mt-3 space-y-2">
        {sources.map((source) => (
          <li key={source.url}>
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex items-start gap-2 text-sm text-zinc-300 hover:text-green-400"
            >
              <ExternalLink size={14} className="mt-1 shrink-0 text-green-400" />
              {source.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  );
}

